# Terraform
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Terraform plan output — never commit
tfplan
*.tfplan
tfplan-*

# Pipeline control surface lives in qgi-pipeline, not here
*.xlsx

# Keep the lock file — it ensures reproducible provider installs
!.terraform.lock.hcl
.claude/settings.json

# Secrets hygiene (#444) — never commit credentials or local editor/IDE config
.env
.env.*
!.env.example
.claude/launch.json
.claude/settings.local.json
.vscode/launch.json
.vscode/settings.json
.idea/
.devcontainer/devcontainer.json.local

# Private keys
*.pem
*.key
*.p12
id_rsa*
credentials

# AWS session files
aws-session.sh
mgmt-session.sh
.aws-session.*
