# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/.playwright/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# TE sample fixtures from S3. 2026-06-01 (founder): the cards-v3 canonical
# shapes are now COMMITTED (the build imports them for match-page overlays);
# the rest of the dataset stays out of git.
/data/te-sample-10/*
!/data/te-sample-10/cards-v3/
/data/te-wave-*/

# Playwright clicky-clicky screenshots (large; regenerate as needed)
/screenshots/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Claude Code local config
.claude/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
preview-screenshots/

# te-fleet-run-1 dataset. 2026-06-04: superseded by te-fleet-run-2 (the live
# vintage); nothing imports run-1 anymore, so it is dropped from git to slim the
# repo (~60MB). Still in S3 (frontend-data/te-fleet-run-1/) + git history +
# reproducible via qgi-ml/scripts/bake_te_fleet_run_1.py.
/data/te-fleet-run-1/

# te-fleet-run-2 dataset (the LIVE vintage, ~96MB). 2026-06-15: moved out of git
# and FETCHED from S3 at build by scripts/fetch-build-data.mjs (prebuild step),
# pinned + per-file checksum-verified via data/build-manifest.json. REQUIRED at
# build — a failed/partial fetch fails the build loudly (no stale deploy). Still
# in S3 (frontend-data/te-fleet-run-2/), git history, and reproducible via the
# fleet bake. Bump the live vintage by regenerating the manifest (npm run
# gen:build-manifest) — a tiny reviewable diff, not a 96MB commit.
/data/te-fleet-run-2/

# localhost-only live-pulse demo snapshot; S3 is the live source on Vercel, never commit
data/hf-pulse-live.json

.vercel
